# Database (server-only, never exposed to the browser)
# Application runtime connection (least-privilege: SELECT only)
DATABASE_URL="postgresql://roadsafe_app:CHANGE_ME@HOST:26257/road_safety?sslmode=verify-full"
# Ingestion service connection (INSERT/UPDATE on data tables, no DDL)
INGEST_DATABASE_URL="postgresql://roadsafe_ingestor:CHANGE_ME@HOST:26257/road_safety?sslmode=verify-full"
# Migration connection (DDL only, used by CI migrate-production workflow)
MIGRATION_DATABASE_URL="postgresql://roadsafe_migrator:CHANGE_ME@HOST:26257/road_safety?sslmode=verify-full"

# Public web app config (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors"
NEXT_PUBLIC_DEFAULT_MAP_LATITUDE="54.5"
NEXT_PUBLIC_DEFAULT_MAP_LONGITUDE="-3.5"
NEXT_PUBLIC_DEFAULT_MAP_ZOOM="5.2"

# Map API limits (server-only)
MAP_RAW_POINT_LIMIT="2000"
MAP_MAX_BOUNDING_BOX_AREA="0.05"

# Ops
LOG_LEVEL="info"

# Ingestion workflow toggles (mirrors GitHub repository variables)
INGESTION_ENABLED="true"
PROVISIONAL_DATA_ENABLED="false"
